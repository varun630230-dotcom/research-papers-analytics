# =============================================================================
# ResearchGap AI - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# =============================================================================

# Google Gemini API Key (required)
# Get your free key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Email for OpenAlex API (gets you into the "polite pool" = faster responses)
OPENALEX_EMAIL=your_email@example.com

# Optional: Semantic Scholar API Key (higher rate limits)
# Request at: https://www.semanticscholar.org/product/api#api-key
SEMANTIC_SCHOLAR_API_KEY=

# Server Configuration
HOST=127.0.0.1
PORT=8000
